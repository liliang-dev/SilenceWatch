# SilenceWatch — self-hosted configuration.
# Copy to .env and fill in. Every setting is an environment variable: nothing
# inside the image ever needs editing.

# --- required ----------------------------------------------------------------
# Three values, and the server names whichever one is missing.

# Root secret. All signing keys are derived from it, so rotating it signs
# everyone out. Generate with: openssl rand -hex 32
SECRET_KEY=

# Password for the bundled PostgreSQL. Generate with: openssl rand -hex 24
# DATABASE_URL is built from it; you only set that yourself when pointing at a
# PostgreSQL this Compose file did not start.
POSTGRES_PASSWORD=

# The URL your users type. Ping URLs and alert links are built from it, so
# getting it wrong produces links nobody can follow.
BASE_URL=http://localhost:8080

# --- HTTPS, if you want it ---------------------------------------------------
# Everything below this block is unnecessary for a plain `docker compose up -d`,
# which serves HTTP on PORT and nothing else.
#
# For TLS, set the two values here and start with the profile instead:
#
#     docker compose --profile tls up -d
#
# Caddy then obtains and renews a certificate on its own. The name has to
# resolve to this machine, and ports 80 and 443 have to be reachable from the
# internet — both are how it proves the name is yours.
# SILENCEWATCH_DOMAIN=status.example.com
#
# With Caddy in front, stop publishing the application's own port to the world:
# left open it is a plain-HTTP way around the certificate, and requests arriving
# on it carry no X-Forwarded-For.
# BIND_ADDRESS=127.0.0.1
#
# Remember BASE_URL above becomes https://your-domain.

# --- alerting ----------------------------------------------------------------
# console | smtp | postmark | brevo. The server refuses to start in production
# with `console`, which drops alerts instead of sending them.
EMAIL_PROVIDER=smtp

# For EMAIL_PROVIDER=smtp — a relay you already trust. Do not run your own SMTP
# for alerts: reputation problems turn into missed alerts on the day they matter.
SMTP_URL=smtp://user:password@smtp.example.com:587

# For EMAIL_PROVIDER=postmark / brevo
POSTMARK_TOKEN=
BREVO_API_KEY=

EMAIL_FROM=alerts@example.com
EMAIL_FROM_NAME=SilenceWatch

# --- who watches the watchman ------------------------------------------------
# A third-party dead man's switch (Healthchecks.io, Cronitor, a colleague's
# SilenceWatch…). The heartbeat is sent only while the detection loop is proven
# alive, so a stalled loop trips the external alarm.
OUTBOUND_HEARTBEAT_URL=

# --- optional ----------------------------------------------------------------
PORT=8080
LOG_LEVEL=info

# Where the client address comes from. Leave false when nothing is proxying
# this server: X-Forwarded-For is trivially spoofable, and every per-IP limit
# would be one header away from being bypassed.
#
# Behind a proxy, name its network rather than saying `true` — in production the
# server rejects a bare true, because it trusts the hop count blindly and so
# lets anything able to reach the port claim any address it likes. With the TLS
# profile, that network is the Compose one:
#
#     TRUST_PROXY=172.28.0.0/16     # or SWARM_SUBNET for a Swarm deployment
#
# Get it wrong in either direction and the server says so in the logs after the
# first twenty requests, with the fix in the message.
TRUST_PROXY=false

# Days of ping history kept. The `ping` table is the one that grows forever.
PING_RETENTION_DAYS=90

# Set to false once your team is set up, to stop new sign-ups. For a private
# instance this is the strongest anti-abuse control there is, and it makes every
# setting in the block below irrelevant.
SIGNUP_ENABLED=true

# --- open sign-up, if you keep it open --------------------------------------
# All off by default. Only worth turning on when strangers can reach the form;
# see docs/abuse-prevention.md for what each one actually buys.

# Require a working email address before an account can sign in. Also makes
# registration enumeration-safe. Needs a real EMAIL_PROVIDER (not console).
# EMAIL_VERIFICATION_REQUIRED=false
# EMAIL_VERIFICATION_TTL_HOURS=24
# UNVERIFIED_ACCOUNT_TTL_DAYS=7

# Proof of work in front of registration: leading zero bits the browser must
# find. 0 is off; 16 costs a laptop ~0.2s and a bot ~100x what it costs now.
# SIGNUP_POW_DIFFICULTY=0

# Reject known throwaway mailbox domains, plus any you add yourself.
# SIGNUP_BLOCK_DISPOSABLE_EMAIL=false
# SIGNUP_BLOCKED_EMAIL_DOMAINS=

# Accounts creatable per hour from one network prefix (IPv4 /24, IPv6 /48),
# counted in PostgreSQL so it survives restarts and extra instances. 0 is off.
# SIGNUP_MAX_PER_NETWORK_PER_HOUR=0

# --- plans and quotas -------------------------------------------------------
# Off, and for a self-hosted instance it stays off: null plan means unlimited on
# every axis. Only relevant if you run SilenceWatch for other people.
# QUOTAS_ENABLED=false
# DEFAULT_PLAN=free
# PLAN_LIMITS={"free":{"checks":10,"projects":3,"channelsPerProject":3,"retentionDays":7}}

# --- recovery and audit -----------------------------------------------------
# How long a password reset link stays valid, and how long the audit trail of
# sign-ins, key changes and channel changes is kept.
# PASSWORD_RESET_TTL_MINUTES=60
# AUDIT_RETENTION_DAYS=365

# Allow alerts to reach private addresses (an internal Mattermost, for example).
# Off by default: it is what stops a webhook from becoming an SSRF into your
# own network.
ALLOW_PRIVATE_NOTIFICATION_TARGETS=false
