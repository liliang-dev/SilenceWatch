<?xml version="1.0" encoding="UTF-8"?>
<!--
  A minimal Spring Boot application with scheduled jobs, used to show — and to
  verify — that adding the starter and an API key is the whole integration.

  Apache-2.0, like everything else under examples/ and clients/.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>com.silencewatch.examples</groupId>
  <artifactId>silencewatch-spring-boot-demo</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>SilenceWatch Spring Boot demo</name>

  <properties>
    <java.version>17</java.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>

    <!-- The only thing an application adds to be monitored. -->
    <dependency>
      <groupId>com.silencewatch</groupId>
      <artifactId>silencewatch-spring-boot-starter</artifactId>
      <version>0.1.0-SNAPSHOT</version>
    </dependency>

    <!-- Present so the demo also exercises Quartz discovery. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-quartz</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
