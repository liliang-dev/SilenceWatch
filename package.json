{
  "name": "silencewatch",
  "version": "0.1.1",
  "private": true,
  "description": "Open-source heartbeat monitoring for cron jobs, workers and scheduled tasks.",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "pnpm@11.19.0+sha512.7881f3ed590d472c4a955e2b88b2121791116066dcc88cbca3849ec9b60f1bbaa6d2ccb221fa91da4e1c65bef2bcbe379365aea7ac539c7bf86dedc3a1b22dce",
  "scripts": {
    "build": "pnpm run build:shared && pnpm run build:server && pnpm run build:web",
    "build:shared": "pnpm --filter @silencewatch/shared run build",
    "build:server": "pnpm --filter @silencewatch/server run build",
    "build:web": "pnpm --filter @silencewatch/web run build",
    "dev": "pnpm --filter @silencewatch/server run dev",
    "dev:web": "pnpm --filter @silencewatch/web run start",
    "test": "pnpm --recursive --workspace-concurrency=1 run test",
    "test:e2e": "pnpm --filter @silencewatch/server run test:e2e",
    "lint": "pnpm --recursive run lint",
    "format": "prettier --write \"packages/*/src/**/*.{ts,html,scss}\"",
    "prisma:generate": "pnpm --filter @silencewatch/server run prisma:generate",
    "prisma:migrate": "pnpm --filter @silencewatch/server run prisma:migrate",
    "loadtest": "pnpm --filter @silencewatch/server run loadtest"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^6.0.3"
  }
}
