{
  "name": "@silencewatch/server",
  "version": "0.1.1",
  "private": true,
  "description": "SilenceWatch server: heartbeat ingestion, silence detection and alerting.",
  "license": "AGPL-3.0-only",
  "main": "dist/main.js",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "node --env-file-if-exists=.env node_modules/@nestjs/cli/bin/nest.js start --watch",
    "diagnostics": "node dist/diagnostics/support-bundle.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "loadtest": "node scripts/loadtest.mjs",
    "postinstall": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node --env-file-if-exists=.env node_modules/prisma/build/index.js migrate dev",
    "start": "node dist/main.js",
    "test": "jest --config jest.config.js",
    "test:e2e": "jest --config jest.e2e.config.js --runInBand"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/static": "^10.1.2",
    "@nestjs/common": "^11.0.6",
    "@nestjs/core": "^11.0.6",
    "@nestjs/platform-fastify": "^11.0.6",
    "@nestjs/schedule": "^6.1.3",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@silencewatch/shared": "workspace:^",
    "cron": "^4.4.0",
    "cron-parser": "^4.9.0",
    "fastify": "^5.10.0",
    "jose": "^5.9.6",
    "nodemailer": "^9.0.3",
    "pg": "^8.13.1",
    "prisma": "^7.9.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.2",
    "@nestjs/testing": "^11.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "autocannon": "^8.0.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
