{
  "name": "@silencewatch/server",
  "version": "0.8.0",
  "private": true,
  "description": "SilenceWatch server: heartbeat ingestion, silence detection and alerting.",
  "license": "Apache-2.0",
  "main": "dist/main.js",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "node --env-file-if-exists=.env node_modules/@nestjs/cli/bin/nest.js start --watch",
    "diagnostics": "node dist/diagnostics/support-bundle.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "loadtest": "node scripts/loadtest.mjs",
    "postinstall": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node --env-file-if-exists=.env node_modules/prisma/build/index.js migrate dev",
    "start": "node dist/main.js",
    "test": "jest --config jest.config.js",
    "test:e2e": "jest --config jest.e2e.config.js --runInBand"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.11",
    "@better-auth/prisma-adapter": "^1.7.11",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/static": "10.1.3",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-fastify": "^11.2.8",
    "@nestjs/schedule": "^6.1.3",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@silencewatch/shared": "workspace:^",
    "better-auth": "^1.7.11",
    "cron": "^4.4.0",
    "cron-parser": "^5.10.2",
    "fastify": "^5.12.7",
    "jose": "^6.2.13",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.2",
    "@nestjs/testing": "^11.2.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "autocannon": "^8.0.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
