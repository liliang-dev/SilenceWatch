{
  "name": "@silencewatch/server",
  "version": "0.1.0",
  "private": true,
  "description": "SilenceWatch server: heartbeat ingestion, silence detection and alerting.",
  "license": "AGPL-3.0-only",
  "main": "dist/main.js",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "nest start --watch",
    "diagnostics": "node dist/diagnostics/support-bundle.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "loadtest": "node scripts/loadtest.mjs",
    "postinstall": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "start": "node dist/main.js",
    "test": "jest --config jest.config.js",
    "test:e2e": "jest --config jest.e2e.config.js --runInBand"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/static": "^8.0.4",
    "@nestjs/common": "^11.0.6",
    "@nestjs/core": "^11.0.6",
    "@nestjs/platform-fastify": "^11.0.6",
    "@nestjs/schedule": "^5.0.1",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.3.0",
    "@silencewatch/shared": "^0.1.0",
    "cron-parser": "^4.9.0",
    "jose": "^5.9.6",
    "nodemailer": "^6.10.0",
    "pg": "^8.13.1",
    "prisma": "^6.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.2",
    "@nestjs/testing": "^11.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "autocannon": "^8.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
