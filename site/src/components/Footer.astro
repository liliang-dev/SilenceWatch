---
import Default from '@astrojs/starlight/components/Footer.astro';
import { APP, REPOSITORY } from '../site';

const lang = Astro.locals.starlightRoute.lang;
const prefix = lang === 'fr' ? '/fr' : '';
const t = lang === 'en'
  ? {
      product: 'Product',
      integrations: 'Integrations',
      openSource: 'Open source',
      app: 'Try it out',
      docs: 'Documentation',
      pricing: 'Pricing',
      jobs: 'Job monitoring',
      java: 'Java',
      php: 'PHP',
      python: 'Python',
      self: 'Self-hosting',
      legal: 'Legal notice',
      privacy: 'Privacy',
      terms: 'Terms of use',
      sales: 'Terms of sale',
      legalNav: 'Legal',
      licence: 'Apache-2.0 licence',
      source: 'Source code',
      security: 'Report a vulnerability',
      note: 'SilenceWatch is open source under the Apache License 2.0. The name and the logo are not covered by it.',
    }
  : {
      product: 'Produit',
      integrations: 'Intégrations',
      openSource: 'Open source',
      app: 'Essayer',
      docs: 'Documentation',
      pricing: 'Tarifs',
      jobs: 'Monitoring de jobs',
      java: 'Java',
      php: 'PHP',
      python: 'Python',
      self: 'Auto-hébergement',
      legal: 'Mentions légales',
      privacy: 'Confidentialité',
      terms: 'Conditions d’utilisation',
      sales: 'Conditions de vente',
      legalNav: 'Informations légales',
      licence: 'Licence Apache-2.0',
      source: 'Code source',
      security: 'Signaler une faille',
      note: 'SilenceWatch est open source sous licence Apache 2.0. Le nom et le logo n’en font pas partie.',
    };
---

<Default />

<footer class="sw-footer">
  <div class="sw-footer-columns">
    <nav aria-labelledby="sw-footer-product">
      <p class="sw-footer-title" id="sw-footer-product">{t.product}</p>
      <ul>
        <li><a href={APP}>{t.app}</a></li>
        <li><a href={`${prefix}/docs/getting-started/`}>{t.docs}</a></li>
        <li><a href={`${prefix}/pricing/`}>{t.pricing}</a></li>
        <li><a href={`${prefix}/job-monitoring/`}>{t.jobs}</a></li>
        <li><a href={`${prefix}/self-hosted/`}>{t.self}</a></li>
      </ul>
    </nav>
    <nav aria-labelledby="sw-footer-integrations">
      <p class="sw-footer-title" id="sw-footer-integrations">{t.integrations}</p>
      <ul>
        <li><a href={`${prefix}/spring-boot/`}>{t.java}</a></li>
        <li><a href={`${prefix}/laravel/`}>{t.php}</a></li>
        <li><a href={`${prefix}/python/`}>{t.python}</a></li>
      </ul>
    </nav>
    <nav aria-labelledby="sw-footer-open-source">
      <p class="sw-footer-title" id="sw-footer-open-source">{t.openSource}</p>
      <ul>
        <li><a href={REPOSITORY}>{t.source}</a></li>
        <li><a href={`${REPOSITORY}/blob/main/LICENSE`}>{t.licence}</a></li>
        <li><a href={`${REPOSITORY}/blob/main/SECURITY.md`}>{t.security}</a></li>
      </ul>
    </nav>
    <nav aria-labelledby="sw-footer-legal">
      <p class="sw-footer-title" id="sw-footer-legal">{t.legalNav}</p>
      <ul>
        <li><a href={`${prefix}/legal/`}>{t.legal}</a></li>
        <li><a href={`${prefix}/privacy/`}>{t.privacy}</a></li>
        <li><a href={`${prefix}/terms/`}>{t.terms}</a></li>
        <li><a href={`${prefix}/sales/`}>{t.sales}</a></li>
      </ul>
    </nav>
  </div>
  <p class="sw-footer-note">{t.note}</p>
</footer>
