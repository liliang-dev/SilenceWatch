---
import { LinkButton } from '@astrojs/starlight/components';
import { home } from '../content/home';
import LiveDemo from './LiveDemo.astro';

/**
 * The first screen of the site, replacing Starlight's hero (only the home page
 * has one). Minimal on purpose: the slogan, large and plain, a sentence, one
 * button and one link; then a single thin heartbeat across the page, the only
 * thing that moves, which goes flat and red for a moment (a job gone quiet, an
 * alert sent) and beats again; then the product, as it is.
 *
 * The words are the page's frontmatter (`hero.title`, `hero.tagline`,
 * `hero.actions`); the proof points and the heartbeat's two notes come from
 * `content/home.ts`. With reduced motion requested the line is still and the page
 * appears at once; the demo has its own rule.
 */
const lang = Astro.locals.starlightRoute.lang === 'en' ? 'en' : 'fr';
const { hero } = home[lang];
const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};

// Three beats, a silence, two beats: the story of one job, as a line.
const beat = (x: number) => `L${x} 60l10 0l8 -10l8 10l8 0l7 -34l9 62l8 -38l7 10l12 0`;
const ecg = `M0 60${[80, 330, 580].map(beat).join('')}L1290 60${[1290, 1530].map(beat).join('')}L1600 60`;
---

<div class="sw-hero">
  <div class="copy">
    <h1 id="_top" data-page-title class="in" style="--d:0" set:html={title} />

    {tagline && <p class="tagline in" style="--d:1" set:html={tagline} />}

    {actions.length > 0 && (
      <div class="actions in" style="--d:2">
        {actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
          <LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
            {text}
            {icon?.html && <Fragment set:html={icon.html} />}
          </LinkButton>
        ))}
      </div>
    )}

    <p class="proof in" style="--d:3">
      {hero.proof.map((point, index) => (
        <>
          {index > 0 && <span class="sep" aria-hidden="true">·</span>}
          <span>{point}</span>
        </>
      ))}
    </p>
  </div>

  <!-- One thin line: it beats, goes flat and red, an alert goes out, it beats again. -->
  <div class="pulse in" style="--d:4" aria-hidden="true">
    <svg viewBox="0 0 1600 120" preserveAspectRatio="none">
      <path class="base" d={ecg} />
      <path class="comet" d={ecg} pathLength="1" />
    </svg>
    <p class="note n-down"><i></i>{hero.pulse.down}</p>
    <p class="note n-up"><i></i>{hero.pulse.up}</p>
  </div>

  <div class="product in" style="--d:5" aria-hidden="true">
    <LiveDemo />
  </div>
</div>

<style>
  .sw-hero {
    --red: #e5484d;
    --green: #30a46c;
    --cycle: 8s;
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 68rem;
    margin-inline: auto;
    padding-top: clamp(2.5rem, 7vw, 5.5rem);
    text-align: center;
  }

  /* ---- The words ------------------------------------------------------------- */

  .copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
    padding-inline: 1rem;
  }

  h1 {
    max-width: 21ch;
    margin: 0;
    font-size: clamp(2.6rem, 0.8rem + 4.2vw, 4.75rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.045em;
    text-wrap: balance;
    color: var(--sl-color-white);
  }

  h1 :global(.sw-answer) {
    display: block;
    color: var(--sl-color-accent-high);
  }

  :global(:root[data-theme='light']) h1 :global(.sw-answer) {
    color: var(--sl-color-accent);
  }

  .tagline {
    max-width: 34rem;
    margin: 0;
    font-size: clamp(var(--sl-text-base), 0.95rem + 0.4vw, var(--sl-text-lg));
    line-height: 1.6;
    text-wrap: pretty;
    color: var(--sl-color-gray-3);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem 1.75rem;
  }

  .actions :global(.sl-link-button) {
    margin: 0;
    font-size: var(--sl-text-base);
    font-weight: 600;
  }

  .actions :global(.sl-link-button.primary) {
    padding: 0.8rem 1.5rem;
    border-color: transparent;
    background: var(--sl-color-accent);
    color: #fff;
    transition: background 150ms ease;
  }

  .actions :global(.sl-link-button.primary:hover) {
    background: var(--sl-color-accent-high);
  }

  :global(:root[data-theme='dark']) .actions :global(.sl-link-button.primary:hover) {
    background: #7a35e8;
  }

  .actions :global(.sl-link-button.minimal) {
    padding: 0.8rem 0.25rem;
    color: var(--sl-color-white);
  }

  .actions :global(.sl-link-button.minimal svg) {
    transition: transform 150ms ease;
  }

  .actions :global(.sl-link-button.minimal:hover svg) {
    transform: translateX(3px);
  }

  .proof {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 0.6rem;
    margin: 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }

  .sep {
    color: var(--sl-color-gray-5);
  }

  /* ---- The line --------------------------------------------------------------- */

  .pulse {
    position: relative;
    width: 100vw;
    height: 6rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .pulse svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .pulse path {
    vector-effect: non-scaling-stroke;
  }

  .base {
    stroke: var(--sl-color-hairline);
    stroke-width: 1;
  }

  .comet {
    stroke: var(--sl-color-white);
    stroke-width: 1.5;
    stroke-dasharray: 0.12 1.2;
    stroke-dashoffset: 0.12;
    animation:
      run var(--cycle) linear infinite,
      tint var(--cycle) linear infinite;
  }

  .note {
    position: absolute;
    top: -0.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    font-size: var(--sl-text-xs);
    white-space: nowrap;
    color: var(--sl-color-gray-3);
    opacity: 0;
    translate: -50% 0;
  }

  .note i {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--colour);
  }

  .n-down {
    --colour: var(--red);
    left: 61%;
    animation: note-down var(--cycle) linear infinite;
  }

  .n-up {
    --colour: var(--green);
    left: 82%;
    animation: note-up var(--cycle) linear infinite;
  }

  /* ---- The product ------------------------------------------------------------ */

  .product {
    width: min(42rem, 100%);
    margin-top: clamp(1rem, 3vw, 2rem);
    padding-inline: 1rem;
  }

  .product :global(.demo) {
    max-width: none;
    padding-inline: 0;
  }

  .product :global(.demo .frame) {
    background: var(--sl-color-bg-nav);
    backdrop-filter: none;
    box-shadow: 0 30px 60px -40px rgb(0 0 0 / 0.45);
  }

  .product :global(figcaption) {
    display: none;
  }

  /* ---- Motion ---------------------------------------------------------------- */

  /* Everything fades up once, in order; afterwards only the line moves. */
  .in {
    animation: in 900ms calc(var(--d) * 110ms + 100ms) cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  @keyframes in {
    from { opacity: 0; transform: translateY(0.75rem); }
  }

  /* The comet's offset runs over 1.24 (its dash, 0.12, plus the line's length,
     1, plus 0.12 so it leaves entirely), so its head is at 1.24 × the time: the
     silence, 48 to 73 % of the line, passes between 39 and 59 % of the cycle.
     Red then, green as the beats come back. */
  @keyframes run {
    from { stroke-dashoffset: 0.12; }
    to { stroke-dashoffset: -1.12; }
  }

  @keyframes tint {
    0%, 37% { stroke: var(--sl-color-white); }
    40%, 59% { stroke: var(--red); }
    62%, 80% { stroke: var(--green); }
    86%, 100% { stroke: var(--sl-color-white); }
  }

  @keyframes note-down {
    0%, 42% { opacity: 0; }
    45%, 59% { opacity: 1; }
    62%, 100% { opacity: 0; }
  }

  @keyframes note-up {
    0%, 63% { opacity: 0; }
    66%, 80% { opacity: 1; }
    83%, 100% { opacity: 0; }
  }

  @media (max-width: 50rem) {
    .n-down,
    .n-up {
      left: 50%;
    }
  }

  @media (max-width: 30rem) {
    .actions {
      flex-direction: column;
      width: 100%;
    }

    .actions :global(.sl-link-button.primary) {
      width: 100%;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .in,
    .comet,
    .note {
      animation: none;
    }

    .comet {
      stroke-dasharray: none;
      stroke: var(--sl-color-gray-4);
    }
  }
</style>
