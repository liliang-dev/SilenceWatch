<script>
  // Sections below the fold are marked, and their titles and contents arrive as
  // they scroll in. Decoration only: without this script, or with reduced motion
  // requested, the page is complete as it stands.
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!calm && 'IntersectionObserver' in window) {
    const sections = Array.from(document.querySelectorAll<HTMLElement>('.sw-home [data-reveal]'));
    const below = sections.filter((section) => section.getBoundingClientRect().top > window.innerHeight * 0.9);
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          (entry.target as HTMLElement).setAttribute('data-reveal', 'done');
          observer.unobserve(entry.target);
        }
      },
      { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
    );
    for (const section of below) {
      section.setAttribute('data-reveal', 'pending');
      observer.observe(section);
    }
  }
</script>
