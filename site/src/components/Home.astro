---
import { home } from '../content/home';
import { APP, REPOSITORY } from '../site';
import Faq from './Faq.astro';
import { iconBody, type IconName } from '../icons';
import Illustration from './Illustration.astro';
import LiveDemo from './LiveDemo.astro';

/**
 * The home page below its hero: the product in motion, how it works in three steps,
 * what it does, and — repeatedly, and without being pushy about it — the way into
 * the application, which is free.
 *
 * Laid out here rather than in Markdown because it needs a grid, a few animations
 * and cards, and written once for both languages from `content/home.ts`. Motion is
 * CSS, with a few lines of script for revealing sections as they scroll in; with
 * reduced motion requested, or without script, everything is simply there.
 */
const lang = Astro.locals.starlightRoute.lang === 'en' ? 'en' : 'fr';
const copy = home[lang];
const prefix = lang === 'fr' ? '/fr' : '';

const escape = (text: string) => text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

/** The little inline markup the copy uses: links, bold, italics and code. */
const md = (text: string): string =>
  escape(text)
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, (_whole, label: string, target: string) =>
      `<a href="${target.startsWith('/') ? prefix + target : target}">${label}</a>`)
    .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
    .replace(/\*([^*]+)\*/g, '<em>$1</em>')
    .replace(/`([^`]+)`/g, '<code>$1</code>');

const url = (path: string) => `${prefix}${path}`;
const login = `${APP}/login`;
---

<div class="sw-home not-content">
  <!-- The heartbeat, running under the hero. -->
  <svg class="ecg" viewBox="0 0 1200 80" preserveAspectRatio="none" aria-hidden="true">
    <path class="base" d="M0 40H430L452 40L470 14L492 66L512 24L528 40H1200" />
    <path class="live" pathLength="1" d="M0 40H430L452 40L470 14L492 66L512 24L528 40H1200" />
  </svg>

  <ul class="trust" aria-label="SilenceWatch">
    {copy.trust.map((item) => <li>{item}</li>)}
  </ul>

  <LiveDemo />

  <section class="works" aria-label={copy.works.label}>
    <p class="works-label">{copy.works.label}</p>
    <div class="marquee" aria-hidden="true">
      <div class="track">
        {[0, 1].map(() => copy.works.items.map((item) => <span>{item}</span>))}
      </div>
    </div>
    <p class="sr-only">{copy.works.items.join(', ')}</p>
  </section>

  <section class="band split" data-reveal>
    <div class="copy">
      <h2>{copy.problem.title}</h2>
      {copy.problem.paragraphs.map((p) => <p set:html={md(p)} />)}
    </div>
    <Illustration name="silence" />
  </section>

  <section class="band" id="how-it-works" data-reveal>
    <div class="head">
      <h2>{copy.how.title}</h2>
      <p>{copy.how.lead}</p>
    </div>
    <ol class="steps">
      {copy.how.steps.map((step, index) => (
        <li class="card" data-spot>
          <span class="num">{index + 1}</span>
          <h3>{step.title}</h3>
          <p set:html={md(step.text)} />
          {index === 1 && (
            <div class="code" role="img" aria-label={copy.how.codeLabel}>
              <span class="label">{copy.how.codeLabel}</span>
              <code><span class="mute">0 2 * * *</span>  backup.sh <span class="op">&amp;&amp;</span> curl -fsS <span class="str">https://app.silencewatch.com/p/&lt;ping-key&gt;</span><i class="caret"></i></code>
            </div>
          )}
        </li>
      ))}
    </ol>
    <p class="note" set:html={md(copy.how.note)} />
  </section>

  <section class="band" data-reveal>
    <div class="head">
      <h2>{copy.features.title}</h2>
    </div>
    <div class="grid">
      {copy.features.items.map((item) => (
        <article class="card feature" data-spot>
          <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" set:html={iconBody(item.icon as IconName)} />
          <h3>{item.title}</h3>
          <p set:html={md(item.text)} />
        </article>
      ))}
    </div>
  </section>

  <section class="band split flip" data-reveal>
    <div class="copy">
      <h2>{copy.which.title}</h2>
      <p set:html={md(copy.which.text)} />
      <ul class="chips">
        {copy.which.chips.map((chip) => <li><a href={url(chip.href)}>{chip.text}</a></li>)}
      </ul>
    </div>
    <Illustration name="hub" />
  </section>

  <section class="band spring" data-reveal>
    <div class="spring-text">
      <h2>{copy.spring.title}</h2>
      <p set:html={md(copy.spring.text)} />
    </div>
    <div class="spring-code" aria-hidden="true">
      <div class="code">
        <span class="label">application.yml</span>
        <code>silencewatch:<br />  api-key: <span class="str">$&#123;SILENCEWATCH_API_KEY&#125;</span></code>
      </div>
      <p class="discovered">{copy.spring.discovered}</p>
      <ul class="jobs">
        {copy.spring.jobs.map((job, index) => (
          <li style={`--i:${index}`}><span>{job.name}</span><em>{job.schedule}</em></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band" data-reveal>
    <h2>{copy.hosted.title}</h2>
    <p set:html={md(copy.hosted.text)} />
    <div class="actions">
      <a class="btn primary" href={login}>{copy.app}<span aria-hidden="true">→</span></a>
      <a class="btn" href={url('/self-hosted/')}>{copy.hosted.secondary}</a>
      <a class="btn ghost" href={REPOSITORY}>{copy.hosted.source}</a>
    </div>
  </section>

  <section class="cta split" data-reveal>
    <div class="copy">
      <h2>{copy.cta.title}</h2>
      <p>{copy.cta.text}</p>
      <div class="actions">
        <a class="btn primary big" href={login}>{copy.cta.primary}<span aria-hidden="true">→</span></a>
        <a class="btn big" href={url('/docs/getting-started/')}>{copy.cta.secondary}</a>
      </div>
      <p class="small">{copy.cta.note} <a href={url('/self-hosted/')}>{copy.hosted.secondary}</a></p>
    </div>
    <Illustration name="alerts" />
  </section>

  <section class="band split" data-reveal>
    <div class="copy">
      <h2>{copy.faq.heading}</h2>
      <Faq title={copy.faq.title} items={copy.faq.items} />
    </div>
    <Illustration name="faq" />
  </section>
</div>

<style is:global>
  .sw-home {
    --gap: clamp(3rem, 7vw, 5.5rem);
    max-width: 68rem;
    margin-inline: auto;
    padding-inline: 1rem;
    position: relative;
  }

  .sw-home h2,
  .sw-home h3,
  .sw-home p,
  .sw-home ul,
  .sw-home ol {
    margin: 0;
  }

  .sw-home .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* --- the heartbeat under the hero ------------------------------------- */
  .sw-home .ecg {
    display: block;
    width: 100vw;
    height: 4rem;
    margin: 0 calc(50% - 50vw);
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    overflow: visible;
  }

  .sw-home .ecg path {
    vector-effect: non-scaling-stroke;
  }

  .sw-home .ecg .base {
    stroke: color-mix(in srgb, var(--sl-color-accent) 30%, transparent);
    stroke-width: 1.5;
  }

  .sw-home .ecg .live {
    stroke: var(--sl-color-accent-high);
    stroke-width: 2.5;
    stroke-dasharray: 0.12 0.88;
    filter: drop-shadow(0 0 6px var(--sl-color-accent));
    animation: sw-travel 4.2s linear infinite;
  }

  @keyframes sw-travel {
    from {
      stroke-dashoffset: 0.12;
    }
    to {
      stroke-dashoffset: -1;
    }
  }

  /* --- what is true about it, at a glance ------------------------------- */
  .sw-home .trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 0.6rem;
    margin-bottom: 2.5rem;
    padding: 0;
    list-style: none;
  }

  .sw-home .trust li {
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 999px;
    background: color-mix(in srgb, var(--sl-color-bg-nav) 70%, transparent);
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }

  .sw-home .trust li::before {
    content: '';
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    margin-right: 0.5rem;
    border-radius: 50%;
    background: #47cd89;
    box-shadow: 0 0 0 0 #47cd89;
    animation: sw-live 2.6s ease-out infinite;
  }

  @keyframes sw-live {
    0% {
      box-shadow: 0 0 0 0 color-mix(in srgb, #47cd89 60%, transparent);
    }
    70%,
    100% {
      box-shadow: 0 0 0 0.5rem transparent;
    }
  }

  /* --- the marquee: it works with everything ---------------------------- */
  .sw-home .works {
    margin-top: var(--gap);
    text-align: center;
  }

  .sw-home .works-label {
    font-size: var(--sl-text-sm);
    letter-spacing: 0.04em;
    color: var(--sl-color-gray-3);
  }

  .sw-home .marquee {
    margin-top: 1rem;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }

  .sw-home .track {
    display: flex;
    width: max-content;
    gap: 0.75rem;
    animation: sw-marquee 38s linear infinite;
  }

  .sw-home .marquee:hover .track {
    animation-play-state: paused;
  }

  .sw-home .track span {
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.6rem;
    background: var(--sl-color-bg-nav);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
    white-space: nowrap;
  }

  @keyframes sw-marquee {
    to {
      transform: translateX(calc(-50% - 0.375rem));
    }
  }

  /* --- sections ---------------------------------------------------------- */
  .sw-home .band {
    margin-top: var(--gap);
  }

  /* Text on one side, a picture on the other: nothing is left empty beside a
     paragraph. The picture goes under the text on a narrow screen. */
  .sw-home .split {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: center;
  }

  .sw-home .split.flip {
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
  }

  .sw-home .split.flip .copy {
    order: 2;
  }

  .sw-home .split .ill {
    max-width: 28rem;
  }

  @media (max-width: 52rem) {
    .sw-home .split,
    .sw-home .split.flip {
      grid-template-columns: minmax(0, 1fr);
    }

    .sw-home .split.flip .copy {
      order: 0;
    }

    .sw-home .split .ill {
      max-width: 20rem;
    }
  }

  .sw-home h2 {
    font-size: clamp(var(--sl-text-2xl), 1.2rem + 1.8vw, var(--sl-text-4xl));
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-wrap: balance;
    color: var(--sl-color-white);
  }

  .sw-home .band > p,
  .sw-home .copy > p,
  .sw-home .head p {
    margin-top: 1rem;
    font-size: var(--sl-text-lg);
    line-height: 1.6;
    color: var(--sl-color-gray-2);
  }

  .sw-home .band > p {
    text-wrap: pretty;
  }

  .sw-home .band > p + p,
  .sw-home .copy > p + p {
    margin-top: 0.9rem;
  }

  .sw-home .head {
    margin-bottom: 2rem;
  }

  .sw-home a {
    color: var(--sl-color-accent-high);
  }

  .sw-home code {
    font-family: var(--sl-font-mono);
    font-size: 0.9em;
  }

  /* --- cards, with a light that follows the pointer --------------------- */
  .sw-home .card {
    position: relative;
    padding: 1.4rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 1rem;
    background: var(--sl-color-bg-nav);
    overflow: hidden;
    transition:
      transform 180ms ease,
      border-color 180ms ease;
  }

  .sw-home .card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      22rem circle at var(--mx, 50%) var(--my, 0%),
      color-mix(in srgb, var(--sl-color-accent) 10%, transparent),
      transparent 60%
    );
    opacity: 0;
    transition: opacity 200ms ease;
    pointer-events: none;
  }

  .sw-home .card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--sl-color-accent) 55%, var(--sl-color-hairline));
  }

  .sw-home .card:hover::before {
    opacity: 1;
  }

  .sw-home .card > * {
    position: relative;
  }

  .sw-home .card h3 {
    font-size: var(--sl-text-lg);
    line-height: 1.3;
    color: var(--sl-color-white);
  }

  .sw-home .card p {
    margin-top: 0.5rem;
    line-height: 1.55;
    color: var(--sl-color-gray-2);
  }

  .sw-home .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1rem;
    padding: 0;
    list-style: none;
  }

  .sw-home .num {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    margin-bottom: 0.9rem;
    border-radius: 50%;
    background: var(--sl-color-accent);
    font-weight: 700;
    color: #fff;
  }

  .sw-home .note {
    margin-top: 1.5rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }

  .sw-home .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 1rem;
  }

  .sw-home .ico {
    width: 2.4rem;
    height: 2.4rem;
    margin-bottom: 0.9rem;
    padding: 0.5rem;
    border-radius: 0.7rem;
    background: color-mix(in srgb, var(--sl-color-accent) 16%, transparent);
    fill: var(--sl-color-accent-high);
  }

  /* --- a command, in a window of its own -------------------------------- */
  .sw-home .code {
    margin-top: 1rem;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.7rem;
    background: var(--sl-color-black);
    overflow-x: auto;
  }

  .sw-home .code .label {
    display: block;
    margin-bottom: 0.35rem;
    font-size: var(--sl-text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }

  .sw-home .code code {
    display: block;
    font-size: var(--sl-text-sm);
    line-height: 1.6;
    color: var(--sl-color-gray-1);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .sw-home .code .mute {
    color: var(--sl-color-gray-3);
  }

  .sw-home .code .op {
    color: var(--sl-color-gray-3);
  }

  .sw-home .code .str {
    color: #47cd89;
  }

  :root[data-theme='light'] .sw-home .code .str {
    color: #067647;
  }

  .sw-home .caret {
    display: inline-block;
    width: 0.5em;
    height: 1.05em;
    margin-left: 0.15em;
    vertical-align: text-bottom;
    background: var(--sl-color-accent-high);
    animation: sw-blink 1.1s steps(1) infinite;
  }

  @keyframes sw-blink {
    50% {
      opacity: 0;
    }
  }

  /* --- chips ------------------------------------------------------------- */
  .sw-home .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.4rem;
    padding: 0;
    list-style: none;
  }

  .sw-home .chips a {
    display: inline-block;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 999px;
    background: var(--sl-color-bg-nav);
    text-decoration: none;
    color: var(--sl-color-gray-1);
    transition:
      border-color 150ms ease,
      transform 150ms ease,
      color 150ms ease;
  }

  .sw-home .chips a:hover {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-white);
    transform: translateY(-2px);
  }

  /* --- Spring Boot ------------------------------------------------------- */
  .sw-home .spring {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: 2rem 3rem;
    align-items: center;
  }

  .sw-home .spring-text p {
    margin-top: 1rem;
    font-size: var(--sl-text-lg);
    line-height: 1.6;
    color: var(--sl-color-gray-2);
  }

  .sw-home .discovered {
    margin-top: 1.1rem;
    font-size: var(--sl-text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }

  .sw-home .jobs {
    margin-top: 0.6rem;
    padding: 0;
    list-style: none;
  }

  .sw-home .jobs li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0.85rem;
    margin-bottom: 0.45rem;
    border: 1px solid var(--sl-color-hairline);
    border-left: 3px solid #47cd89;
    border-radius: 0.6rem;
    background: var(--sl-color-bg-nav);
    font-size: var(--sl-text-sm);
    animation: sw-slide 7s ease-out infinite;
    animation-delay: calc(var(--i) * 0.45s);
  }

  .sw-home .jobs li span {
    font-family: var(--sl-font-mono);
    font-weight: 600;
    color: var(--sl-color-white);
  }

  .sw-home .jobs li em {
    font-style: normal;
    color: var(--sl-color-gray-3);
    white-space: nowrap;
  }

  @keyframes sw-slide {
    0% {
      opacity: 0;
      transform: translateX(-0.75rem);
    }
    8%,
    88% {
      opacity: 1;
      transform: none;
    }
    100% {
      opacity: 0;
    }
  }

  /* --- buttons ----------------------------------------------------------- */
  .sw-home .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.6rem;
  }

  .sw-home .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.2rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 999px;
    background: var(--sl-color-bg-nav);
    font-weight: 600;
    text-decoration: none;
    color: var(--sl-color-white);
    transition:
      transform 150ms ease,
      box-shadow 150ms ease,
      border-color 150ms ease;
  }

  .sw-home .btn:hover {
    transform: translateY(-2px);
    border-color: var(--sl-color-accent);
  }

  .sw-home .btn.ghost {
    border-color: transparent;
    background: none;
    color: var(--sl-color-gray-2);
  }

  .sw-home .btn.primary {
    border-color: transparent;
    background: #7a35e8;
    color: #fff;
    box-shadow: 0 10px 24px -12px #7a35e8;
  }

  .sw-home .btn.primary:hover {
    background: #6c1bee;
    box-shadow: 0 14px 30px -12px #7a35e8;
  }

  .sw-home .btn.primary span {
    transition: transform 150ms ease;
  }

  .sw-home .btn.primary:hover span {
    transform: translateX(4px);
  }

  .sw-home .btn.big {
    padding: 0.85rem 1.6rem;
    font-size: var(--sl-text-lg);
  }

  /* --- the closing call to action: a flat panel, text and picture ------- */
  .sw-home .cta {
    margin-top: var(--gap);
    padding: clamp(1.8rem, 5vw, 3.2rem);
    border: 1px solid color-mix(in srgb, var(--sl-color-accent) 45%, var(--sl-color-hairline));
    border-radius: 1.4rem;
    background: var(--sl-color-bg-nav);
  }

  /* On the panel, cards and secondary buttons take the page's own colour so that
     they read as objects on it rather than as part of it. */
  .sw-home .cta .ill {
    --card: var(--sl-color-bg);
  }

  .sw-home .cta .btn:not(.primary) {
    background: var(--sl-color-bg);
  }

  .sw-home .cta p {
    margin-top: 1rem;
    font-size: var(--sl-text-lg);
    color: var(--sl-color-gray-2);
  }

  .sw-home .cta .small {
    margin-top: 1.4rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }

  /* --- scroll reveal: only when the script has marked the section ------- */
  .sw-home [data-reveal='pending'] {
    opacity: 0;
    transform: translateY(1.5rem);
  }

  .sw-home [data-reveal] {
    transition:
      opacity 650ms ease,
      transform 650ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    .sw-home *,
    .sw-home *::before,
    .sw-home *::after {
      animation: none !important;
      transition: none !important;
    }

    .sw-home .ecg .live {
      stroke-dasharray: none;
    }

    .sw-home .marquee {
      overflow-x: auto;
    }

    .sw-home [data-reveal='pending'] {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 34rem) {
    .sw-home .actions .btn {
      flex: 1 1 100%;
      justify-content: center;
    }
  }
</style>

<script>
  // Sections fade in as they scroll into view, and cards light up under the pointer.
  // Both are decoration: without this script, or with reduced motion requested,
  // the page is complete as it stands.
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!calm && 'IntersectionObserver' in window) {
    const sections = Array.from(document.querySelectorAll<HTMLElement>('.sw-home [data-reveal]'));
    const below = sections.filter((section) => section.getBoundingClientRect().top > window.innerHeight * 0.9);
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          (entry.target as HTMLElement).setAttribute('data-reveal', 'done');
          observer.unobserve(entry.target);
        }
      },
      { threshold: 0.08 },
    );
    for (const section of below) {
      section.setAttribute('data-reveal', 'pending');
      observer.observe(section);
    }
  }

  if (!calm) {
    for (const card of document.querySelectorAll<HTMLElement>('.sw-home [data-spot]')) {
      card.addEventListener('pointermove', (event) => {
        const box = card.getBoundingClientRect();
        card.style.setProperty('--mx', `${event.clientX - box.left}px`);
        card.style.setProperty('--my', `${event.clientY - box.top}px`);
      });
    }
  }
</script>
