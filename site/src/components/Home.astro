---
import { home } from '../content/home';
import { APP, REPOSITORY } from '../site';
import Faq from './Faq.astro';
import { iconBody, type IconName } from '../icons';
import { PLANS, pricing } from '../content/plans';

/**
 * The home page below its hero, in the hero's own manner: wide, left-aligned
 * and typographic. Each section opens on a hairline with its number and its name
 * in small capitals, then a large title, which rises into place word by word as
 * the section scrolls in; lines rather than boxes divide what is inside.
 *
 * The order tells the story: what it works with, the problem (a week of one job's
 * runs, which stop without a word), how it works (three steps, each with the
 * piece of the product it is about), what it does, the integrations, the jobs it
 * is for, the price, the questions, and a last, large call to action.
 *
 * Written once for both languages from `content/home.ts`. The motion is CSS, with
 * a few lines of script that mark sections as they scroll in; with reduced motion
 * requested, or without script, everything is simply there.
 */
const lang = Astro.locals.starlightRoute.lang === 'en' ? 'en' : 'fr';
const copy = home[lang];
const plans = pricing[lang];
const prefix = lang === 'fr' ? '/fr' : '';
const { hero, demo } = copy;

const escape = (text: string) => text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

/** The little inline markup the copy uses: links, bold, italics and code. */
const md = (text: string): string =>
  escape(text)
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, (_whole, label: string, target: string) =>
      `<a href="${target.startsWith('/') ? prefix + target : target}">${label}</a>`)
    .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
    .replace(/\*([^*]+)\*/g, '<em>$1</em>')
    .replace(/`([^`]+)`/g, '<code>$1</code>');

/** A title, each word in its own masked box so that it can rise into place. */
const words = (text: string): string =>
  escape(text)
    .split(/\s+/)
    .filter(Boolean)
    .map((word, i) => `<span class="w"><span style="--i:${i}">${word}</span></span>`)
    .join(' ');

const url = (path: string) => `${prefix}${path}`;
const two = (n: number) => String(n).padStart(2, '0');

const money = new Intl.NumberFormat(lang === 'fr' ? 'fr-FR' : 'en-GB', {
  style: 'currency',
  currency: 'EUR',
  minimumFractionDigits: 0,
  maximumFractionDigits: 2,
});
const formatPrice = (amount: number) => money.format(amount);
const login = `${APP}/login`;

// The sections, numbered in the order they appear.
const n = { problem: 1, how: 2, features: 3, spring: 4, which: 5, pricing: 6, faq: 7 };

// The problem's week: three nights that ran, one that did not.
const runs = ['1 min 12 s', '1 min 09 s', '1 min 15 s'];
---

<div class="sw-home not-content">
  <section class="works" aria-label={copy.works.label}>
    <div class="wrap">
      <p class="works-label">{copy.works.label}</p>
    </div>
    <div class="marquee" aria-hidden="true">
      <div class="track">
        {[0, 1].map(() => copy.works.items.map((item) => <span>{item}<i></i></span>))}
      </div>
    </div>
    <p class="sr-only">{copy.works.items.join(', ')}</p>
  </section>

  <!-- 01 · The problem -->
  <section class="sec" data-reveal>
    <div class="wrap">
      <p class="sec-head"><span>{two(n.problem)}</span>{copy.labels.problem}</p>
      <div class="problem">
        <h2 class="display" set:html={words(copy.problem.title)} />
        <div class="problem-body">
          {copy.problem.paragraphs.map((p, i) => <p class="body rise" style={`--d:${i}`} set:html={md(p)} />)}
          <figure class="panel log rise" style="--d:2" aria-hidden="true">
            <div class="bar"><i></i><i></i><i></i><span>{hero.field.job} · 0 2 * * *</span></div>
            <ol>
              {runs.map((time, i) => (
                <li class="ok rise" style={`--d:${i + 3}`}>
                  <span class="day">{copy.problem.log.days[i]}</span>
                  <span>02:00</span>
                  <span class="state">✓ {copy.problem.log.done}</span>
                  <span class="meta">{time}</span>
                </li>
              ))}
              <li class="none rise" style="--d:6">
                <span class="day">{copy.problem.log.days[3]}</span>
                <span>02:00</span>
                <span class="state">— {copy.problem.log.nothing}</span>
                <span class="meta"></span>
              </li>
              <li class="alert rise" style="--d:7">
                <span class="day">{copy.problem.log.days[3]}</span>
                <span>02:15</span>
                <span class="state"><i></i>{copy.problem.log.alert}</span>
                <span class="meta">SilenceWatch</span>
              </li>
            </ol>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 · How it works -->
  <section class="sec" id="how-it-works" data-reveal>
    <div class="wrap">
      <p class="sec-head"><span>{two(n.how)}</span>{copy.labels.how}</p>
      <div class="sec-title">
        <h2 class="display" set:html={words(copy.how.title)} />
        <p class="lead rise">{copy.how.lead}</p>
      </div>
      <ol class="steps">
        {copy.how.steps.map((step, index) => (
          <li class="step rise" style={`--d:${index + 1}`}>
            <span class="step-n">{two(index + 1)}</span>
            <h3>{step.title}</h3>
            <p set:html={md(step.text)} />
            <div class="mock">
              {index === 0 && (
                <dl class="panel form" aria-hidden="true">
                  <div><dt>{copy.how.form.schedule}</dt><dd>0 2 * * *</dd></div>
                  <div><dt>{copy.how.form.timezone}</dt><dd>Europe/Paris</dd></div>
                  <div><dt>{copy.how.form.grace}</dt><dd>15 min</dd></div>
                </dl>
              )}
              {index === 1 && (
                <div class="panel code" role="img" aria-label={copy.how.codeLabel}>
                  <span class="label">{copy.how.codeLabel}</span>
                  <code><span class="mute">0 2 * * *</span>  backup.sh <span class="op">&amp;&amp;</span> curl -fsS <span class="str">https://app.silencewatch.com/p/&lt;ping-key&gt;</span><i class="caret"></i></code>
                </div>
              )}
              {index === 2 && (
                <div class="panel toast" aria-hidden="true">
                  <span class="toast-dot"></span>
                  <div>
                    <b>{hero.field.job} · {demo.states.down}</b>
                    <span>{hero.field.silent}</span>
                    <span>{hero.field.alert}</span>
                  </div>
                </div>
              )}
            </div>
          </li>
        ))}
      </ol>
      <p class="note rise" style="--d:4" set:html={md(copy.how.note)} />
    </div>
  </section>

  <!-- 03 · What it does -->
  <section class="sec" data-reveal>
    <div class="wrap">
      <p class="sec-head"><span>{two(n.features)}</span>{copy.labels.features}</p>
      <h2 class="display" set:html={words(copy.features.title)} />
      <ul class="rows">
        {copy.features.items.map((item, index) => (
          <li class="row rise" style={`--d:${index}`}>
            <span class="row-n">{two(index + 1)}</span>
            <svg class="row-ico" viewBox="0 0 24 24" aria-hidden="true" set:html={iconBody(item.icon as IconName)} />
            <h3>{item.title}</h3>
            <p set:html={md(item.text)} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 04 · Integrations -->
  <section class="sec" data-reveal>
    <div class="wrap">
      <p class="sec-head"><span>{two(n.spring)}</span>{copy.labels.spring}</p>
      <div class="spring">
        <div>
          <h2 class="display" set:html={words(copy.spring.title)} />
          <p class="body rise" style="--d:1" set:html={md(copy.spring.text)} />
        </div>
        <div class="panel term rise" style="--d:2" aria-hidden="true">
          <div class="bar"><i></i><i></i><i></i><span>application.yml</span></div>
          <code class="yml">silencewatch:<br />  api-key: <span class="str">$&#123;SILENCEWATCH_API_KEY&#125;</span></code>
          <p class="discovered">{copy.spring.discovered}</p>
          <ul class="jobs">
            {copy.spring.jobs.map((job, index) => (
              <li class="rise" style={`--d:${index + 3}`}><i></i><span>{job.name}</span><em>{job.schedule}</em></li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 05 · Which jobs -->
  <section class="sec" data-reveal>
    <div class="wrap">
      <p class="sec-head"><span>{two(n.which)}</span>{copy.labels.which}</p>
      <div class="which">
        <div>
          <h2 class="display" set:html={words(copy.which.title)} />
          <p class="body rise" style="--d:1" set:html={md(copy.which.text)} />
        </div>
        <ul class="tags">
          {copy.which.chips.map((chip, index) => (
            <li class="rise" style={`--d:${index * 0.5 + 1}`}>
              <a href={url(chip.href)}>
                {chip.text}
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" /></svg>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- 06 · Pricing -->
  <section class="sec" id="pricing" data-reveal>
    <div class="wrap">
      <p class="sec-head"><span>{two(n.pricing)}</span>{copy.labels.pricing}</p>
      <div class="sec-title">
        <h2 class="display" set:html={words(copy.pricing.title)} />
        <p class="lead rise">{copy.pricing.lead}</p>
      </div>

      <div class="paths">
        <article class="path self rise" style="--d:1">
          <p class="path-tag">{copy.pricing.self.badge}</p>
          <h3>{copy.pricing.self.title}</h3>
          <p class="price">{copy.pricing.self.price}</p>
          <ul class="checks">
            {copy.pricing.self.points.map((point) => <li>{point}</li>)}
          </ul>
          <div class="path-actions">
            <a class="btn" href={url('/self-hosted/')}>{copy.pricing.self.guide}</a>
            <a class="link" href={REPOSITORY}>{copy.pricing.self.source}<span aria-hidden="true">→</span></a>
          </div>
        </article>

        <span class="or" aria-hidden="true">{copy.pricing.or}</span>

        <article class="path hosted rise" style="--d:2">
          <p class="path-tag">{copy.pricing.hosted.title}</p>
          <p class="hosted-text">{copy.pricing.hosted.text}</p>
          <ul class="plans">
            {PLANS.map((plan) => (
              <li class="plan">
                <h3>{plans.names[plan.id]}</h3>
                <p class="amount">
                  <strong>{formatPrice(plan.price)}</strong>
                  <span>{plans.perMonth}</span>
                </p>
                <ul class="checks small">
                  <li>{plans.limits.checks(plan.checks)}</li>
                  <li>{plans.limits.projects(plan.projects)}</li>
                  <li>{plans.limits.channels(plan.channelsPerProject)}</li>
                  <li>{plans.limits.retention(plan.retentionDays)}</li>
                </ul>
              </li>
            ))}
          </ul>
          <div class="path-actions">
            <a class="btn primary" href={login}>{copy.pricing.hosted.cta}<span aria-hidden="true">→</span></a>
            <a class="link" href={url('/pricing/')}>{copy.pricing.hosted.details}<span aria-hidden="true">→</span></a>
            <span class="fine">{copy.pricing.note}</span>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- 07 · Questions -->
  <section class="sec" data-reveal>
    <div class="wrap">
      <p class="sec-head"><span>{two(n.faq)}</span>{copy.labels.faq}</p>
      <div class="faq">
        <h2 class="display" set:html={words(copy.faq.heading)} />
        <div class="rise" style="--d:1">
          <Faq title={copy.faq.title} items={copy.faq.items} />
        </div>
      </div>
    </div>
  </section>

  <!-- The last word -->
  <section class="closing" data-reveal>
    <div class="closing-field" aria-hidden="true"><span class="beacon"></span></div>
    <div class="wrap">
      <h2 class="giant" set:html={words(copy.cta.title)} />
      <div class="closing-foot rise" style="--d:2">
        <p>{copy.cta.text}</p>
        <div class="closing-actions">
          <a class="btn primary big" href={login}>{copy.cta.primary}<span aria-hidden="true">→</span></a>
          <a class="link" href={url('/docs/getting-started/')}>{copy.cta.secondary}<span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>
</div>

<style is:global>
  .sw-home {
    --red: #ff5a63;
    --green: #3ddc97;
    --pad: clamp(1.25rem, 4vw, 3.5rem);
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    width: 100vw;
    margin-inline: calc(50% - 50vw);
  }

  :root[data-theme='light'] .sw-home {
    --red: #e5484d;
    --green: #1f9d63;
  }

  .sw-home h2,
  .sw-home h3,
  .sw-home p,
  .sw-home ul,
  .sw-home ol,
  .sw-home dl,
  .sw-home dd,
  .sw-home figure {
    margin: 0;
  }

  .sw-home .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* The same column as the hero's words. */
  .sw-home .wrap {
    max-width: 84rem;
    margin-inline: auto;
    padding-inline: var(--pad);
  }

  /* Links in running text; buttons, links set apart and tags have their own. */
  .sw-home p a {
    color: var(--sl-color-accent-high);
    text-underline-offset: 0.2em;
  }

  :root[data-theme='light'] .sw-home p a {
    color: var(--sl-color-text-accent);
  }

  .sw-home code {
    font-family: var(--sl-font-mono);
    font-size: 0.9em;
  }

  /* ---- What it works with: a slow line of large names ------------------------------ */

  .sw-home .works {
    padding-top: clamp(4rem, 9vw, 7rem);
  }

  .sw-home .works-label,
  .sw-home .sec-head {
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }

  .sw-home .marquee {
    margin-top: 1.25rem;
    padding-block: clamp(1.1rem, 2.5vw, 1.75rem);
    border-block: 1px solid var(--sl-color-hairline);
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .sw-home .track {
    display: flex;
    width: max-content;
    animation: sw-marquee 70s linear infinite;
  }

  .sw-home .track span {
    display: inline-flex;
    align-items: center;
    gap: clamp(1.5rem, 3vw, 2.75rem);
    padding-inline-end: clamp(1.5rem, 3vw, 2.75rem);
    font-size: clamp(1.5rem, 0.9rem + 1.8vw, 2.75rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    white-space: nowrap;
    color: var(--sl-color-gray-4);
    transition: color 250ms ease;
  }

  .sw-home .track span:hover {
    color: var(--sl-color-white);
  }

  .sw-home .track i {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--sl-color-accent);
  }

  @keyframes sw-marquee {
    to { transform: translateX(-50%); }
  }

  /* ---- A section: a hairline, its number and name, a large title -------------------- */

  .sw-home .sec {
    padding-top: clamp(5.5rem, 11vw, 10rem);
  }

  .sw-home .sec-head {
    display: flex;
    gap: 1rem;
    padding-top: 1rem;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
    border-top: 1px solid var(--sl-color-hairline);
  }

  .sw-home .sec-head span {
    color: var(--sl-color-accent-high);
  }

  :root[data-theme='light'] .sw-home .sec-head span {
    color: var(--sl-color-accent);
  }

  .sw-home .display {
    max-width: 17ch;
    font-size: clamp(2.25rem, 0.9rem + 3.6vw, 4.5rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.048em;
    text-wrap: balance;
    color: var(--sl-color-white);
  }

  .sw-home .sec-title {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    align-items: end;
    gap: 1.5rem clamp(2rem, 6vw, 6rem);
  }

  .sw-home .lead,
  .sw-home .body {
    font-size: clamp(var(--sl-text-base), 0.95rem + 0.3vw, 1.2rem);
    line-height: 1.6;
    text-wrap: pretty;
    color: var(--sl-color-gray-2);
  }

  .sw-home .lead {
    max-width: 26rem;
  }

  .sw-home .body + .body {
    margin-top: 1rem;
  }

  .sw-home strong {
    font-weight: 600;
    color: var(--sl-color-white);
  }

  /* Something drawn from the product: a panel with a hairline edge. */
  .sw-home .panel {
    border: 1px solid var(--sl-color-hairline);
    border-radius: 1rem;
    background: color-mix(in srgb, var(--sl-color-bg-nav) 80%, transparent);
    box-shadow: 0 30px 60px -45px rgb(0 0 0 / 0.6);
    font-family: var(--sl-font-mono);
    font-size: 0.8rem;
  }

  .sw-home .panel .bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--sl-color-hairline);
    color: var(--sl-color-gray-3);
  }

  .sw-home .panel .bar i {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--sl-color-gray-5);
  }

  .sw-home .panel .bar span {
    margin-inline-start: 0.6rem;
  }

  /* ---- 01 · The problem ------------------------------------------------------- */

  .sw-home .problem {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 2.5rem clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .sw-home .log {
    margin-top: 2.25rem;
  }

  .sw-home .log ol {
    padding: 0.4rem 0;
    list-style: none;
  }

  .sw-home .log li {
    display: grid;
    grid-template-columns: 2.75rem 3.25rem minmax(0, 1fr) auto;
    gap: 0.75rem;
    align-items: center;
    padding: 0.6rem 1rem;
    color: var(--sl-color-gray-3);
  }

  .sw-home .log .day {
    color: var(--sl-color-gray-4);
  }

  .sw-home .log .ok .state {
    color: var(--green);
  }

  .sw-home .log .none .state {
    color: var(--sl-color-gray-4);
    font-style: italic;
  }

  .sw-home .log .alert {
    margin: 0.35rem 0.5rem 0.1rem;
    padding-inline: 0.5rem;
    border-radius: 0.6rem;
    background: color-mix(in srgb, var(--red) 12%, transparent);
    color: var(--sl-color-white);
  }

  .sw-home .log .alert .state {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .sw-home .log .alert i,
  .sw-home .toast-dot {
    position: relative;
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--red);
  }

  .sw-home .log .alert i::after,
  .sw-home .toast-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: inherit;
    animation: sw-ring 1.8s ease-out infinite;
  }

  @keyframes sw-ring {
    to { scale: 3.2; opacity: 0; }
  }

  .sw-home .log .meta {
    color: var(--sl-color-gray-4);
  }

  .sw-home .log .alert .meta {
    color: var(--red);
  }

  /* ---- 02 · How it works ------------------------------------------------------- */

  .sw-home .steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
    padding: 0;
    border-top: 1px solid var(--sl-color-hairline);
    list-style: none;
  }

  /* A light runs along the line above the steps, from the first to the last. */
  .sw-home .steps::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 22%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--sl-color-accent-high), transparent);
    animation: sw-run 5s linear infinite;
  }

  @keyframes sw-run {
    0% { translate: 0 0; opacity: 0; }
    10%, 90% { opacity: 1; }
    100% { translate: 355% 0; opacity: 0; }
  }

  .sw-home .step {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 2rem clamp(1rem, 2.5vw, 2.25rem) 0;
    border-inline-start: 1px solid var(--sl-color-hairline);
  }

  .sw-home .step:first-child {
    padding-inline-start: 0;
    border-inline-start: 0;
  }

  .sw-home .step:last-child {
    padding-inline-end: 0;
  }

  .sw-home .step-n {
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    color: var(--sl-color-accent-high);
  }

  :root[data-theme='light'] .sw-home .step-n {
    color: var(--sl-color-accent);
  }

  .sw-home .step h3 {
    font-size: clamp(1.3rem, 1rem + 0.6vw, 1.6rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--sl-color-white);
  }

  .sw-home .step p {
    line-height: 1.6;
    color: var(--sl-color-gray-2);
  }

  .sw-home .mock {
    margin-top: auto;
    padding-top: 1.25rem;
  }

  .sw-home .form > div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1rem;
  }

  .sw-home .form > div + div {
    border-top: 1px solid var(--sl-color-hairline);
  }

  .sw-home .form dt {
    color: var(--sl-color-gray-3);
  }

  .sw-home .form dd {
    color: var(--sl-color-white);
  }

  .sw-home .code {
    padding: 0.8rem 1rem;
    overflow-x: auto;
  }

  .sw-home .code .label {
