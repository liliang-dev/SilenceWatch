# The registry, stated rather than inherited. A machine with a different
# default — a company mirror, a leftover experiment — would otherwise resolve
# this project's dependencies somewhere else, and the lockfile records the
# resolved URL, so it would be noticed only in review.
registry=https://registry.npmjs.org/

# pnpm's own settings live in pnpm-workspace.yaml, which is where pnpm reads
# them from. Only registry and authentication belong here.
